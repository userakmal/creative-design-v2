# ============================================
#   config.php — internetdan to'liq yashirish
# ============================================
<Files "config.php">
    Order allow,deny
    Deny from all
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

# ============================================
#   .htaccess fayllarini yashirish
# ============================================
<Files ".htaccess">
    Order allow,deny
    Deny from all
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

# ============================================
#   Maxfiy fayl turlari (log, env, bak — fail-safe)
# ============================================
<FilesMatch "\.(log|sqlite|sqlite3|env|ini|bak|backup)$">
    Order allow,deny
    Deny from all
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ============================================
#   logs/ papkasiga kirishni bloklash
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bu papkadagi rewrite'lar uchun base — ota-saytning SPA routing'iga aralashmaydi
    RewriteBase /oyim/
    RewriteRule ^logs(/.*)?$ - [F,L]
</IfModule>

# ============================================
#   Xavfsizlik header'lari
# ============================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "no-referrer"
    Header set Permissions-Policy "geolocation=(self)"
</IfModule>

# ============================================
#   Asosiy sahifa
# ============================================
DirectoryIndex index.html
