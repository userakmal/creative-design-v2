{
  "name": "creative-design-platform",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Creative Design Platform - PHP backend + React frontend",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "install:all": "cd client && npm install",
    "dev": "cd client && npm run dev",
    "dev:video": "cd api-server/video-downloader && python api_enhanced.py",
    "build": "cd client && npm run build",
    "preview": "cd client && npm run preview",
    "lint": "cd client && npm run lint",
    "clean": "rimraf node_modules client/node_modules client/dist dist"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
