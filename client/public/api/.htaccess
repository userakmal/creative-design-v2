# ============================================================================
# /api/.htaccess — backup-only PHP limits + lock down internal files.
# The real limits live in .user.ini (PHP-FPM honors that even when this
# .htaccess is ignored). Keep these php_value lines in case the host
# still uses mod_php instead of PHP-FPM.
# ============================================================================

<IfModule mod_php.c>
    php_value upload_max_filesize 4096M
    php_value post_max_size       4200M
    php_value memory_limit        512M
    php_value max_execution_time  3600
    php_value max_input_time      3600
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 4096M
    php_value post_max_size       4200M
    php_value memory_limit        512M
    php_value max_execution_time  3600
    php_value max_input_time      3600
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 4096M
    php_value post_max_size       4200M
    php_value memory_limit        512M
    php_value max_execution_time  3600
    php_value max_input_time      3600
</IfModule>

# Files starting with "_" are internal — never serve them directly.
<FilesMatch "^_">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
